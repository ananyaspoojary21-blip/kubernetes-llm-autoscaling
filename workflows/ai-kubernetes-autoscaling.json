    {
      "parameters": {
        "jsCode": "function getValue(nodeName) {\n  const item = $(nodeName).first().json;\n  const result = item?.data?.result;\n\n  if (!result || result.length === 0) {\n    return null;\n  }\n\n  const value = Number(result[0]?.value?.[1]);\n\n  return Number.isFinite(value) ? value : null;\n}\n\nconst cpu = getValue(\"Prometheus - CPU\");\nconst memory = getValue(\"Prometheus - Memory\");\nconst requestRate = getValue(\"Prometheus - Request Rate\");\nconst requestRate5m = getValue(\"Prometheus - Request Rate 5m\");\nconst p95Latency = getValue(\"Prometheus - P95 Latency\");\nconst currentReplicas = getValue(\"Prometheus - Current Replicas\");\nconst hpaDesiredReplicas = getValue(\"Prometheus - HPA Desired Replicas\");\nconst minReplicas = 1;\nconst maxReplicas = 5;\n\n// Calculate traffic trend\nlet trafficChangePercent = null;\nlet trafficTrend = \"unknown\";\n\nif (\n  requestRate !== null &&\n  requestRate5m !== null &&\n  requestRate5m !== 0\n) {\n  trafficChangePercent =\n    ((requestRate - requestRate5m) / requestRate5m) * 100;\n\n  if (trafficChangePercent > 15) {\n    trafficTrend = \"increasing\";\n  } else if (trafficChangePercent < -15) {\n    trafficTrend = \"decreasing\";\n  } else {\n    trafficTrend = \"stable\";\n  }\n}\n\nconst context = {\n  service: \"autoscaling-demo\",\n\n  cpu_utilization_percent: cpu,\n  memory_utilization_percent: memory,\n\n  request_rate_rps: requestRate,\n  request_rate_5m_rps: requestRate5m,\n  traffic_change_percent: trafficChangePercent,\n  traffic_trend: trafficTrend,\n\n  p95_latency_seconds: p95Latency,\n  sla_latency_threshold_seconds: 2,\n\n  current_replicas: currentReplicas,\n  hpa_desired_replicas: hpaDesiredReplicas,\n\n  min_replicas: minReplicas,\n  max_replicas: maxReplicas\n};\n\nreturn [\n  {\n    json: context\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
