    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  JSON.stringify({\n    model: \"llama3.2:3b\",\n    stream: false,\n    format: \"json\",\n    prompt: `You are a Kubernetes autoscaling decision engine.\n\nAnalyze the workload context below and recommend the desired number of replicas.\n\nReturn ONLY valid JSON with exactly these fields:\n- recommended_replicas: integer\n- confidence: low, medium, or high\n- reasoning: short string\n- urgency: low, normal, or high\n\nRules:\n1. Never recommend below min_replicas or above max_replicas.\n2. Never change replicas by more than 2 from current_replicas.\n3. CPU above 80% indicates high CPU pressure.\n4. CPU below 30% indicates low CPU pressure.\n5. Traffic change above +15% is increasing.\n6. Traffic change below -15% is decreasing.\n7. Otherwise traffic is stable.\n8. The SLA latency threshold is 2 seconds for this experiment.\n9. If p95 latency exceeds the SLA, consider scaling up.\n10. Consider all supplied metrics together.\n11. Do not invent metrics.\n\nWorkload context:\n${JSON.stringify($json)}\n`\n  })\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2432,
        -64
      ],
      "id": "fa571a32-369c-4f2d-8aae-eda7a1e8b0ad",
      "name": "Ollama - Scaling Decision"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\n// Ollama returns the model's JSON inside the `response` field.\nlet decision;\n\ntry {\n  decision = JSON.parse(input.response);\n} catch (error) {\n  return [{\n    json: {\n      action: \"NO_ACTION\",\n      valid: false,\n      reason: \"Ollama returned malformed JSON\",\n      raw_response: input.response ?? null\n    }\n  }];\n}\n\n// Required fields\nconst requiredFields = [\n  \"recommended_replicas\",\n  \"confidence\",\n  \"reasoning\",\n  \"urgency\"\n];\n\nconst missingFields = requiredFields.filter(\n  field => decision[field] === undefined || decision[field] === null\n);\n\nif (missingFields.length > 0) {\n  return [{\n    json: {\n      action: \"NO_ACTION\",\n      valid: false,\n      reason: `Missing required fields: ${missingFields.join(\", \")}`,\n      raw_decision: decision\n    }\n  }];\n}\n\n// Get current scaling limits from Build Scaling Context\nconst context = $(\"Build Scaling Context\").first().json;\n\nconst current = Number(context.current_replicas);\nconst min = Number(context.min_replicas);\nconst max = Number(context.max_replicas);\n\nconst requested = Number(decision.recommended_replicas);\n\n// Validate numeric values\nif (\n  !Number.isFinite(current) ||\n  !Number.isFinite(min) ||\n  !Number.isFinite(max) ||\n  !Number.isInteger(requested)\n) {\n  return [{\n    json: {\n      action: \"NO_ACTION\",\n      valid: false,\n      reason: \"Invalid replica value detected\",\n      raw_decision: decision\n    }\n  }];\n}\n\n// Hard bounds\nif (requested < min || requested > max) {\n  return [{\n    json: {\n      action: \"NO_ACTION\",\n      valid: false,\n      reason: `AI recommendation ${requested} is outside allowed range ${min}-${max}`,\n      raw_decision: decision\n    }\n  }];\n}\n\n// Maximum scaling step\nconst change = requested - current;\n\nlet validatedRequested = requested;\n\nif (Math.abs(change) > 2) {\n  const direction = change > 0 ? 1 : -1;\n  validatedRequested = current + (2 * direction);\n}\n\nconst validatedChange = validatedRequested - current;\n\n// Validate enum values\nconst validConfidence = [\"low\", \"medium\", \"high\"];\nconst validUrgency = [\"low\", \"normal\", \"high\"];\n\nif (!validConfidence.includes(decision.confidence)) {\n  return [{\n    json: {\n      action: \"NO_ACTION\",\n      valid: false,\n      reason: `Invalid confidence value: ${decision.confidence}`,\n      raw_decision: decision\n    }\n  }];\n}\n\nif (!validUrgency.includes(decision.urgency)) {\n  return [{\n    json: {\n      action: \"NO_ACTION\",\n      valid: false,\n      reason: `Invalid urgency value: ${decision.urgency}`,\n      raw_decision: decision\n    }\n  }];\n}\n\n// Safety validation passed\nreturn [{\n  json: {\n   action: validatedRequested === current ? \"NO_ACTION\" : \"SCALE\",\n    valid: true,\n    current_replicas: current,\n    recommended_replicas: validatedRequested,\n    replica_change: validatedChange,\n    min_replicas: min,\n    max_replicas: max,\n    confidence: decision.confidence,\n    urgency: decision.urgency,\n    reasoning: decision.reasoning\n  }\n}];"
      },
